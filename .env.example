# Claude Code data path (auto-detected in Docker; override for local dev)
CLAUDE_DATA_PATH=~/.claude

# SQLite database path
DATABASE_URL=sqlite:////app/data/devlens.db

# GitHub Copilot integration (optional)
# Requires a PAT with 'copilot' scope for Copilot usage analytics
# GITHUB_TOKEN=ghp_...
# GITHUB_ORG=your-org-name   # set for org-level Copilot plan usage
